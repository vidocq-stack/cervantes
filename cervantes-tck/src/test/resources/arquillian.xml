<?xml version="1.0" encoding="UTF-8"?>
<!--
    Arquillian configuration for the MicroProfile JWT 2.2 TCK suite.
    The "cervantes-jwt" qualifier is selected by the system property
    arquillian.launch=cervantes-jwt (see cervantes-tck/pom.xml, tck-official profile).
-->
<arquillian xmlns="http://jboss.org/schema/arquillian"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://jboss.org/schema/arquillian
                                http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <container qualifier="cervantes-jwt" default="true">
        <configuration>
            <property name="host">127.0.0.1</property>
        </configuration>
    </container>
</arquillian>
