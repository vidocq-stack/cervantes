<?xml version="1.0" encoding="UTF-8"?>
<!--
    cervantes-tck — Model 4.0.0 standalone, sans <parent>.
    IMPORTANT: ce module est VOLONTAIREMENT exclu du reactor cervantes-parent.
    Raison: ShrinkWrap Maven Resolver 3.3 ne sait pas parser les POMs Model 4.1.0.
    Toujours invoquer via run-official-tck-mp-jwt-2.1.sh.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.vidocq.cervantes</groupId>
    <artifactId>cervantes-tck</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Cervantes :: TCK Runner</name>
    <description>Harness de conformance MicroProfile JWT 2.1 — TCK officiel TestNG/Arquillian</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <cervantes.version>0.3.0-SNAPSHOT</cervantes.version>
        <microprofile.jwt.version>2.1</microprofile.jwt.version>
        <vauban.version>0.3.0-SNAPSHOT</vauban.version>
        <ravel.version>0.3.0-SNAPSHOT</ravel.version>
        <champollion.version>0.3.0-SNAPSHOT</champollion.version>
        <cassini.version>0.3.0-SNAPSHOT</cassini.version>
        <chappe.version>0.3.0-SNAPSHOT</chappe.version>
    </properties>

    <repositories>
        <repository>
            <id>vidocq-snapshots</id>
            <url>https://repo.vidocq.dev/snapshots</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- Cervantes implementation modules -->
        <dependency>
            <groupId>io.vidocq.cervantes</groupId>
            <artifactId>cervantes-mp-jwt-api</artifactId>
            <version>${cervantes.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cervantes</groupId>
            <artifactId>cervantes-api</artifactId>
            <version>${cervantes.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cervantes</groupId>
            <artifactId>cervantes-core</artifactId>
            <version>${cervantes.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cervantes</groupId>
            <artifactId>cervantes-cdi-vauban</artifactId>
            <version>${cervantes.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cervantes</groupId>
            <artifactId>cervantes-jaxrs</artifactId>
            <version>${cervantes.version}</version>
        </dependency>

        <!-- Cassini TCK harness (CassiniTestHarness) — installed via run script.
             Excludes its transitive Arquillian 1.8.0.Final to avoid classpath collision
             with the 1.10.1.Final used by arquillian-testng-container. -->
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-tck</artifactId>
            <version>${cassini.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.jboss.arquillian.container</groupId>
                    <artifactId>arquillian-container-spi</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.jboss.arquillian.core</groupId>
                    <artifactId>arquillian-core-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.jboss.arquillian.core</groupId>
                    <artifactId>arquillian-core-spi</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Cassini (JAX-RS runtime) -->
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-core</artifactId>
            <version>${cassini.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-chappe</artifactId>
            <version>${cassini.version}</version>
        </dependency>
        <!-- cassini-cdi-vauban: VaubanBeanProvider + VaubanRequestScopeFilter (request scope per HTTP request) -->
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-cdi-vauban</artifactId>
            <version>${cassini.version}</version>
        </dependency>

        <!-- Chappe HTTP server -->
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-api</artifactId>
            <version>${chappe.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.chappe</groupId>
            <artifactId>chappe-core</artifactId>
            <version>${chappe.version}</version>
        </dependency>

        <!-- Vauban CDI -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <version>${vauban.version}</version>
        </dependency>

        <!-- Ravel MP Config -->
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-core</artifactId>
            <version>${ravel.version}</version>
        </dependency>
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-mp-config-api</artifactId>
            <version>${ravel.version}</version>
        </dependency>
        <!-- ravel-cdi-vauban: ConfigCdiExtension (BCE @ConfigProperty producers for CDI injection) -->
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-cdi-vauban</artifactId>
            <version>${ravel.version}</version>
        </dependency>

        <!-- Champollion JSON-P -->
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <version>${champollion.version}</version>
        </dependency>

        <!-- Jakarta APIs -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>4.1.0</version>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <version>2.0.1</version>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>3.0.0</version>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <version>4.0.0</version>
        </dependency>

        <!-- JUnit Jupiter for smoke test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Arquillian container SPI — aligned with 1.10.1.Final used by TCK profile -->
        <dependency>
            <groupId>org.jboss.arquillian.container</groupId>
            <artifactId>arquillian-container-spi</artifactId>
            <version>1.10.1.Final</version>
            <scope>test</scope>
        </dependency>

        <!-- MP JWT API (official, not repackaged) needed by TCK -->
        <dependency>
            <groupId>org.eclipse.microprofile.jwt</groupId>
            <artifactId>microprofile-jwt-auth-api</artifactId>
            <version>${microprofile.jwt.version}</version>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>25</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
            Profil par défaut : smoke test JUnit — vérifie que les modules Cervantes
            et la spec MP JWT 2.1 sont bien sur le classpath.
        -->
        <profile>
            <id>smoke</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <testExcludes>
                                <exclude>io/vidocq/cervantes/tck/arquillian/**</exclude>
                            </testExcludes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <useModulePath>false</useModulePath>
                            <excludes>
                                <exclude>io/vidocq/cervantes/tck/arquillian/**</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Profil TCK officiel : Arquillian TestNG + container Cervantes custom
            (CervantesJwtDeployableContainer démarrant Chappe+Vauban+Cassini).
            Cible : 100 % PASS (EJB/JACC optionals exclus).
        -->
        <profile>
            <id>tck-official</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <useModulePath>false</useModulePath>
                            <dependenciesToScan>
                                <dependency>org.eclipse.microprofile.jwt:microprofile-jwt-auth-tck</dependency>
                            </dependenciesToScan>
                            <includes>
                                <include>**/*Test.class</include>
                                <include>**/*Tests.class</include>
                            </includes>
                            <excludes>
                                <!-- EJB optional tests — not applicable -->
                                <exclude>org/eclipse/microprofile/jwt/tck/container/ejb/**</exclude>
                                <!-- JACC optional tests — not applicable -->
                                <exclude>org/eclipse/microprofile/jwt/tck/container/jacc/**</exclude>
                                <!-- Servlet optional tests — Chappe is not a Jakarta Servlet container -->
                                <exclude>org/eclipse/microprofile/jwt/tck/container/servlet/**</exclude>
                            </excludes>
                            <!-- TestNG group exclusions:
                                 ee-security-optional: group-to-role mapping via EE Security API, not implemented.
                            -->
                            <excludedGroups>ee-security-optional</excludedGroups>
                            <redirectTestOutputToFile>false</redirectTestOutputToFile>
                            <useFile>false</useFile>
                            <forkedProcessExitTimeoutInSeconds>120</forkedProcessExitTimeoutInSeconds>
                            <systemPropertyVariables>
                                <arquillian.launch>cervantes-jwt</arquillian.launch>
                            </systemPropertyVariables>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.apache.maven.surefire</groupId>
                                <artifactId>surefire-testng</artifactId>
                                <version>3.5.5</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
            <dependencies>
                <!-- TCK jar (utility/base classes) -->
                <dependency>
                    <groupId>org.eclipse.microprofile.jwt</groupId>
                    <artifactId>microprofile-jwt-auth-tck</artifactId>
                    <version>${microprofile.jwt.version}</version>
                    <scope>test</scope>
                </dependency>
                <!-- TCK test classes jar -->
                <dependency>
                    <groupId>org.eclipse.microprofile.jwt</groupId>
                    <artifactId>microprofile-jwt-auth-tck</artifactId>
                    <version>${microprofile.jwt.version}</version>
                    <classifier>tests</classifier>
                    <scope>test</scope>
                </dependency>

                <!-- Arquillian TestNG integration -->
                <dependency>
                    <groupId>org.jboss.arquillian.testng</groupId>
                    <artifactId>arquillian-testng-container</artifactId>
                    <version>1.10.1.Final</version>
                    <scope>test</scope>
                </dependency>

                <!-- TestNG -->
                <dependency>
                    <groupId>org.testng</groupId>
                    <artifactId>testng</artifactId>
                    <version>7.10.2</version>
                    <scope>test</scope>
                </dependency>

                <!-- jose4j — used by TCK TokenUtils to sign test JWTs -->
                <dependency>
                    <groupId>org.bitbucket.b_c</groupId>
                    <artifactId>jose4j</artifactId>
                    <version>0.9.4</version>
                    <scope>test</scope>
                </dependency>

                <!-- SLF4J for jose4j -->
                <dependency>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                    <version>2.0.9</version>
                    <scope>test</scope>
                </dependency>

                <!-- Jersey CLIENT: TCK uses JAX-RS Client to call the server under test -->
                <dependency>
                    <groupId>org.glassfish.jersey.core</groupId>
                    <artifactId>jersey-client</artifactId>
                    <version>4.0.2</version>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.glassfish.jersey.inject</groupId>
                    <artifactId>jersey-hk2</artifactId>
                    <version>4.0.2</version>
                    <scope>test</scope>
                </dependency>

                <!-- MP Config API needed by TCK -->
                <dependency>
                    <groupId>org.eclipse.microprofile.config</groupId>
                    <artifactId>microprofile-config-api</artifactId>
                    <version>3.1</version>
                    <scope>test</scope>
                </dependency>

                <!-- Jakarta JSON API needed by TCK -->
                <dependency>
                    <groupId>jakarta.json</groupId>
                    <artifactId>jakarta.json-api</artifactId>
                    <version>2.1.3</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
