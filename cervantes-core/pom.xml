<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.cervantes</groupId>
        <artifactId>cervantes-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>cervantes-core</artifactId>
    <name>Cervantes :: Core</name>
    <description>Pure Java 25 engine: JWT parsing, signature verification (RS/ES 256/384/512 via java.security), claim validation (iss/aud/exp/nbf/iat + clock-skew), key loading (PEM, JWKS). No CDI, no JAX-RS.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.cervantes</groupId>
            <artifactId>cervantes-api</artifactId>
        </dependency>
        <!-- JSON-P via Champollion: jakarta.json to decode header/payload -->
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-api</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JSON-P implementation (JsonProvider) for the tests (on the classpath via ServiceLoader) -->
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Java Modules workaround (see heisenberg-core): module-info.java in src/main/module-info/
                to avoid activating Java Modules at testCompile (test deps without Automatic-Module-Name
                on the module-path). 1) clean removes module-info.class before testCompile;
                2) compile recompiles module-info.java alone at prepare-package;
                3) surefire runs the tests on the classpath.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <!--
                            Bound to process-sources (BEFORE compile), not only before testCompile:
                            in an incremental build without `clean`, the module-info.class left by
                            the previous build's compile-module-info would flip default-compile
                            into module mode (test/classpath deps not found on the module-path).
                            prepare-package recompiles it afterwards. On a clean build this is a no-op.
                        -->
                        <id>remove-stale-module-info</id>
                        <phase>process-sources</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}</directory>
                                    <includes>
                                        <include>module-info.class</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
