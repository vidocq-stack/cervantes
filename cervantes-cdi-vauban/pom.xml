<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.cervantes</groupId>
        <artifactId>cervantes-parent</artifactId>
        <version>0.2.0</version>
    </parent>

    <artifactId>cervantes-cdi-vauban</artifactId>
    <name>Cervantes :: CDI (Vauban)</name>
    <description>Intégration CDI : producteur @RequestScoped JsonWebToken, contexte de requête, et production du JwtValidator piloté par MicroProfile Config (Ravel). L'injection @Claim typée est un raffinement ultérieur (voir ROADMAP).</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.cervantes</groupId>
            <artifactId>cervantes-core</artifactId>
        </dependency>
        <!-- MicroProfile Config API (module org.eclipse.microprofile.config) via Ravel — lit mp.jwt.* -->
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-mp-config-api</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Vauban SPI (compile-only, like jakarta.cdi): lets module-info declare
             `provides VaubanComponentProvider with _VaubanComponents`. `provided` is non-transitive
             and pairs with `requires static`, so a Weld deployment pulls neither this nor vauban-core. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Container CDI Vauban pour les tests d'intégration -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-classloader-spi</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Implémentation MicroProfile Config pour les tests (Ravel) -->
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Implémentation JSON-P pour les tests (forge de tokens via TestJwts) -->
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                JPMS workaround (cf. cervantes-core) : module-info.java dans src/main/module-info/.
                Nettoyage lié à process-sources (avant compile) pour les builds incrémentaux.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>remove-stale-module-info</id>
                        <phase>process-sources</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}</directory>
                                    <includes>
                                        <include>module-info.class</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        Vauban codegen now runs as an ANNOTATION PROCESSOR on this module's own beans
                        (the Maven plugin is reserved for freezing external, non-APT-processed jars).
                        The main compile generates _ClientProxy/_Factory, META-INF/vauban-beans.list
                        (runtime discovery for the Vidocq scanClasspath) and one in-module
                        _VaubanComponents per package (instantiation, field injection and producer
                        invocation of the @Claim BCE-backed beans, the JsonWebToken context and the
                        JsonWebToken/JwtValidator producers — no `opens … to io.vidocq.vauban.core`).
                        Build-time only: no compile/runtime dependency on Vauban, inert under Weld.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>${vauban.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <!-- Test fixtures are not application beans (the embedded-Vauban CDI tests
                         resolve their nested fixtures reflectively). Running the APT over them would
                         emit a provider for nested test classes (bogus package / cannot find symbol). -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <!-- No annotation processing on the separate module-info compile
                                 (the beans were already processed in the main compile). -->
                            <proc>none</proc>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
