    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.cervantes</groupId>
    <artifactId>cervantes-parent</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Cervantes</name>
    <description>MicroProfile JWT 2.2 implementation — no third-party library, crypto via java.security, JSON via Champollion, config via Ravel, strict Java Modules, virtual threads, CDI via Vauban</description>
    <url>https://codefloe.com/Vidocq/cervantes</url>

