<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.4.0-RC1</version>
        <relativePath />
    </parent>

    <groupId>io.vidocq.cervantes</groupId>
    <artifactId>cervantes-parent</artifactId>
    <version>0.4.0-RC1</version>
    <packaging>pom</packaging>

    <name>Cervantes</name>
    <description>MicroProfile JWT 2.2 implementation — no third-party library, crypto via java.security, JSON via Champollion, config via Ravel, strict Java Modules, virtual threads, CDI via Vauban</description>
    <url>https://codefloe.com/Vidocq/cervantes</url>

    
    <licenses>
        <license>
            <name>EPL-2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>EUPL-1.2</name>
            <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://codefloe.com/Vidocq/cervantes</url>
        <connection>scm:git:https://codefloe.com/Vidocq/cervantes.git</connection>
        <developerConnection>scm:git:git@codefloe.com:Vidocq/cervantes.git</developerConnection>
    </scm>

    <properties>
        
        <microprofile.jwt.version>2.2</microprofile.jwt.version>

        
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>
        <jakarta.ws.rs.version>4.0.0</jakarta.ws.rs.version>

        
        <champollion.version>0.4.0-RC1</champollion.version>
        <ravel.version>0.4.0-RC1</ravel.version>
        <vauban.version>0.4.0-RC1</vauban.version>
        <cassini.version>0.4.0-RC1</cassini.version>

        
        <jmh.version>1.37</jmh.version>

        
        <ci.tck.command>mvn -B -ntp -P tck,tck-official -pl cervantes-tck test</ci.tck.command>

        
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/cervantes-coverage/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        
        <sonar.coverage.exclusions>**/cervantes-examples/**</sonar.coverage.exclusions>
        
        <sonar.issue.ignore.multicriteria>examples</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.examples.ruleKey>java:S106</sonar.issue.ignore.multicriteria.examples.ruleKey>
        <sonar.issue.ignore.multicriteria.examples.resourceKey>**/cervantes-examples/**/src/main/java/**</sonar.issue.ignore.multicriteria.examples.resourceKey>
    </properties>

    
    <modules>
        <module>cervantes-mp-jwt-api</module>
        <module>cervantes-api</module>
        <module>cervantes-core</module>
        <module>cervantes-cdi-vauban</module>
        <module>cervantes-jaxrs</module>
        <module>cervantes-it-other-containers</module>
        <module>cervantes-bench</module>
        <module>cervantes-examples</module>
    </modules>

    <profiles>
        
        <profile>
            <id>tck</id>
            <modules>
                <module>cervantes-tck</module>
            </modules>
        </profile>
        
        <profile>
            <id>quality</id>
            <modules>
                <module>cervantes-coverage</module>
            </modules>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            
            <dependency>
                <groupId>io.vidocq.cervantes</groupId>
                <artifactId>cervantes-mp-jwt-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            
            <dependency>
                <groupId>org.eclipse.microprofile.jwt</groupId>
                <artifactId>microprofile-jwt-auth-api</artifactId>
                <version>${microprofile.jwt.version}</version>
            </dependency>

            
            <dependency>
                <groupId>io.vidocq.cervantes</groupId>
                <artifactId>cervantes-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cervantes</groupId>
                <artifactId>cervantes-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cervantes</groupId>
                <artifactId>cervantes-cdi-vauban</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cervantes</groupId>
                <artifactId>cervantes-jaxrs</artifactId>
                <version>${project.version}</version>
            </dependency>

            
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>${jakarta.inject.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>${jakarta.ws.rs.version}</version>
            </dependency>

            
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-api</artifactId>
                <version>${champollion.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-jsonp</artifactId>
                <version>${champollion.version}</version>
            </dependency>

            
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-mp-config-api</artifactId>
                <version>${ravel.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-core</artifactId>
                <version>${ravel.version}</version>
            </dependency>

            
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-api</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-core</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-classloader-spi</artifactId>
                <version>${vauban.version}</version>
            </dependency>

            
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-api</artifactId>
                <version>${cassini.version}</version>
            </dependency>
            
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-chappe</artifactId>
                <version>${cassini.version}</version>
            </dependency>

            
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>