    <scm>
        <url>https://codefloe.com/Vidocq/cervantes</url>
        <connection>scm:git:https://codefloe.com/Vidocq/cervantes.git</connection>
        <developerConnection>scm:git:git@codefloe.com:Vidocq/cervantes.git</developerConnection>
    </scm>

    <properties>
        <!--
            MicroProfile JWT 2.2 API. The official artifact has NEITHER a module-info NOR an
            Automatic-Module-Name: it is repackaged as an explicit named module by
            cervantes-mp-jwt-api (module name: org.eclipse.microprofile.jwt).
            Compile dependencies of the spec: jakarta.json-api + jakarta.enterprise.cdi-api.
        -->
        <microprofile.jwt.version>2.2</microprofile.jwt.version>

        <!-- Jakarta EE 11 -->
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>
        <jakarta.ws.rs.version>4.0.0</jakarta.ws.rs.version>

        <!-- Upstream Vidocq implementations -->
        <champollion.version>0.4.0-SNAPSHOT</champollion.version>
        <ravel.version>0.4.0-SNAPSHOT</ravel.version>
        <vauban.version>0.4.0-SNAPSHOT</vauban.version>
        <cassini.version>0.4.0-SNAPSHOT</cassini.version>

        <!-- JMH for cervantes-bench -->
        <jmh.version>1.37</jmh.version>

        <!--
            The TCK this repository's pull requests are gated on (Vidocq/GestionProjet#9). Read by
            the shared pr-validate workflow, which skips the step when this property is absent.

            The certification profile is named explicitly because a plain `-Ptck` would not run it:
            the root `tck` profile only adds cervantes-tck to the reactor, and inside cervantes-tck
            the `smoke` profile is activeByDefault. `-Ptck` alone would therefore pass on a subset
            while reporting success — the vacuous gate this campaign exists to remove.

            This became possible only once cervantes-tck stopped depending on io.vidocq.cassini:
            cassini-tck, an artefact that is published nowhere (Vidocq/cassini#36) and which this
            module never used — it named CassiniTestHarness in one Javadoc comment and nothing else.

            Measured on a clean local repository (empty ~/.m2, the state of a CI runner): the
            official MicroProfile JWT 2.1 TCK ran 206 tests in 13 s, all green, every artefact
            resolved from Maven Central.
        -->
        <ci.tck.command>mvn -B -ntp -P tck,tck-official -pl cervantes-tck test</ci.tck.command>
    </properties>

    <!--
        TCK harmonisation: cervantes-tck joins the reactor ONLY under the `tck` Maven
        profile (see <profiles> below), following the vidocq-runtime-tck-* runner
        pattern. The historical reason for keeping it out-of-reactor — ShrinkWrap Maven
        Resolver 3.3 unable to parse Model 4.1.0 POMs — is obsolete since the workspace
        migrated to Maven 3.9.16 / Model 4.0.0. A regular `mvn install` still skips it;
        activate it with `./mvnw -Ptck -pl cervantes-tck test` or via
        run-official-tck-mp-jwt-2.2.sh.
    -->
    <modules>
        <module>cervantes-mp-jwt-api</module>
        <module>cervantes-api</module>
        <module>cervantes-core</module>
        <module>cervantes-cdi-vauban</module>
        <module>cervantes-jaxrs</module>
        <module>cervantes-it-other-containers</module>
        <module>cervantes-bench</module>
        <module>cervantes-examples</module>
    </modules>

    <profiles>
        <!--
            `tck` profile: pulls the official MP JWT 2.2 TCK runner into the reactor.
            Not active by default so a plain build never downloads nor runs the TCK.
        -->
        <profile>
            <id>tck</id>
            <modules>
                <module>cervantes-tck</module>
            </modules>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <!-- MP JWT 2.2 spec — repackaged (named module), consumed by the Cervantes modules -->
            <dependency>
                <groupId>io.vidocq.cervantes</groupId>
                <artifactId>cervantes-mp-jwt-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Official API, kept for the TCK runner only -->
            <dependency>
                <groupId>org.eclipse.microprofile.jwt</groupId>
                <artifactId>microprofile-jwt-auth-api</artifactId>
                <version>${microprofile.jwt.version}</version>
            </dependency>

            <!-- Modules internes Cervantes -->
            <dependency>
                <groupId>io.vidocq.cervantes</groupId>
                <artifactId>cervantes-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cervantes</groupId>
                <artifactId>cervantes-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cervantes</groupId>
                <artifactId>cervantes-cdi-vauban</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.cervantes</groupId>
                <artifactId>cervantes-jaxrs</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Jakarta CDI / Inject / Annotation (provided in the modules that need them) -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>${jakarta.inject.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>${jakarta.ws.rs.version}</version>
            </dependency>

            <!-- JSON-P via Champollion (fournit jakarta.json transitivement) -->
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-api</artifactId>
                <version>${champollion.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.champollion</groupId>
                <artifactId>champollion-jsonp</artifactId>
                <version>${champollion.version}</version>
            </dependency>

            <!-- Config via Ravel (MP Config) -->
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-mp-config-api</artifactId>
                <version>${ravel.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-core</artifactId>
                <version>${ravel.version}</version>
            </dependency>

            <!-- CDI via Vauban (test scope in the modules) -->
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-api</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-core</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-classloader-spi</artifactId>
                <version>${vauban.version}</version>
            </dependency>

            <!-- JAX-RS via Cassini (security integration, M4) -->
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-api</artifactId>
                <version>${cassini.version}</version>
            </dependency>
            <!-- Chappe adapter: provides a JAX-RS RuntimeDelegate (cervantes-jaxrs tests) -->
            <dependency>
                <groupId>io.vidocq.cassini</groupId>
                <artifactId>cassini-chappe</artifactId>
                <version>${cassini.version}</version>
            </dependency>

            <!-- JMH -->
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
