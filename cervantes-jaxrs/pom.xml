<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.cervantes</groupId>
        <artifactId>cervantes-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>cervantes-jaxrs</artifactId>
    <name>Cervantes :: Cassini (JAX-RS security)</name>
    <description>Sécurité JAX-RS MicroProfile JWT 2.1 : JwtAuthenticationFilter (auth bearer + SecurityContext), RolesAllowedDynamicFeature (@RolesAllowed/@PermitAll/@DenyAll). API JAX-RS standard — validé contre Cassini mais impl-agnostique.</description>

    <dependencies>
        <!-- Validateur + principal (cervantes-api) et contexte de requête CDI (cervantes-cdi-vauban) -->
        <dependency>
            <groupId>io.vidocq.cervantes</groupId>
            <artifactId>cervantes-cdi-vauban</artifactId>
        </dependency>

        <!-- MicroProfile Config API : lecture de mp.jwt.token.header / mp.jwt.token.cookie -->
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-mp-config-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- API JAX-RS standard : filtres, DynamicFeature, SecurityContext -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Vauban SPI (compile-only, non-transitive): lets module-info declare the
             VaubanComponentProvider service. Absent under Weld (requires static + provided). -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Implémentation JSON-P pour forger des tokens de test -->
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Fournit un jakarta.ws.rs.ext.RuntimeDelegate pour construire des Response dans les tests -->
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-chappe</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Java Modules workaround (cf. cervantes-core) : nettoyage lié à process-sources. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>remove-stale-module-info</id>
                        <phase>process-sources</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}</directory>
                                    <includes>
                                        <include>module-info.class</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        Vauban codegen now runs as an ANNOTATION PROCESSOR on this module's own
                        @Provider beans (the Maven plugin is reserved for freezing external jars).
                        The main compile generates META-INF/vauban-beans.list (Vidocq scanClasspath
                        discovery) and an in-module _VaubanComponents that instantiates the no-arg
                        @Provider beans and field-injects their cross-module dependencies (JwtValidator,
                        JsonWebTokenContext, both produced in cervantes-cdi-vauban) — no
                        `opens … to io.vidocq.vauban.core`. Build-time only, inert under Weld.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>${vauban.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <!-- The @Provider beans inject JwtValidator / JsonWebTokenContext, which are
                             produced in cervantes-cdi-vauban (another module). The APT cannot see beans
                             from dependency modules, so its compile-time bean-resolution check would
                             fail here; full validation happens at runtime assembly (Vidocq). -->
                        <arg>-Avauban.validation=false</arg>
                    </compilerArgs>
                </configuration>
                <executions>
                    <!-- Test fixtures are not application beans. Running the APT over them would
                         emit a provider for nested test classes (bogus package / cannot find symbol). -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <!-- No annotation processing on the separate module-info compile. -->
                            <proc>none</proc>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
