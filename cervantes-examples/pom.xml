<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>

    <parent>
        <groupId>io.vidocq.cervantes</groupId>
        <artifactId>cervantes-parent</artifactId>
    </parent>

    <artifactId>cervantes-examples</artifactId>
    <name>Cervantes :: Examples</name>
    <description>Exemples d'utilisation de MicroProfile JWT 2.1 via Cervantes : ressource JAX-RS @RolesAllowed + injection @Inject @Claim. Rempli à partir de M7.</description>

    <properties>
        <!--
            Module de démonstration : jamais publié comme dépendance (deploy.skip), et javadoc.skip
            car un module d'exemples sans API publique fait échouer le canari javadoc au deploy.
        -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
    </properties>

</project>
