<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.cervantes</groupId>
        <artifactId>cervantes-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>cervantes-examples</artifactId>
    <name>Cervantes :: Examples</name>
    <description>Examples of MicroProfile JWT 2.2 usage through Cervantes: a JAX-RS @RolesAllowed resource + @Inject @Claim injection, demonstrated under an embedded Vauban container.</description>

    <properties>
        <!--
            Demo module: never published as a dependency (deploy.skip), and javadoc.skip
            because an examples module with no public API makes the javadoc canary fail at deploy.
            No module-info: the example runs on the classpath (the test drives an embedded Vauban
            container — same approach as the integration tests of cervantes-cdi-vauban).
        -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <dependencies>
        <!-- API MicroProfile JWT 2.2 : @Claim, Claims, ClaimValue, JsonWebToken. -->
        <dependency>
            <groupId>io.vidocq.cervantes</groupId>
            <artifactId>cervantes-mp-jwt-api</artifactId>
        </dependency>
        <!-- Annotations JAX-RS (@Path/@GET/@Produces) — via cassini-api. -->
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- @RolesAllowed/@PermitAll/@DenyAll. -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- @Inject + CDI. -->
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test: end-to-end demonstration under an embedded Vauban (no HTTP server). -->
        <dependency>
            <groupId>io.vidocq.cervantes</groupId>
            <artifactId>cervantes-cdi-vauban</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.cervantes</groupId>
            <artifactId>cervantes-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-classloader-spi</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.champollion</groupId>
            <artifactId>champollion-jsonp</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
